# Repository metadata and local developer state
.git/
.gitignore
.aixignore
.aix/
.agents/
.github/
.zcode/
.mastergo/
**/.DS_Store
/env.json

# Development tools, tests and dependencies
/scripts/
/dev/
/tests/
node_modules/
coverage/
package.json
