<view class="delegate-card">
  <view class="delegate-head">
    <view class="delegate-brand">
      <image class="delegate-logo" src="../../assets/icons/prism-logo.svg" />
      <text class="delegate-title">{{text.delegate.title}}</text>
    </view>
    <view class="delegate-indicator">
      <view ink:for="{{indicators}}" ink:key="index" class="delegate-ind-item">
        <view class="delegate-ind-line {{item.lineClassName}}" ink:if="{{index > 0}}"></view>
        <view class="delegate-ind-dot {{item.className}}">{{item.mark}}</view>
      </view>
    </view>
  </view>

  <view class="delegate-body">
    <text class="delegate-step-title">{{stepTitle}}</text>
    <text class="delegate-step-content" ink:if="{{stepContent}}">{{stepContent}}</text>
  </view>

  <view class="delegate-enter {{enterClassName}}" ink:if="{{enterVisible}}" bindtap="openConversation">
    <text class="delegate-enter-text">{{text.delegate.enterConversation}}</text>
  </view>
</view>
