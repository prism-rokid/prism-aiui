<view class="delegate-card">
  <view class="delegate-main-row">
    <text class="delegate-title">{{text.delegate.title}}</text>
    <text class="delegate-status" ink:if="{{statusVisible}}">{{statusText}}</text>
    <view class="delegate-dots" ink:if="{{dotsVisible}}">
      <view ink:for="{{dots}}" ink:key="index" class="delegate-dot {{item.className}}"></view>
    </view>
  </view>
  <text class="delegate-request {{requestClassName}}" ink:if="{{requestText}}">{{requestText}}</text>
</view>
