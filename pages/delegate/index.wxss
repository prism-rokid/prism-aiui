/* 委托卡片（设计稿形态）：填满宿主槽位（语音链路 BOUNDED ~168px，全屏
   352px）。左上 logo+标题，右上五步指示器，下方步骤标题 + 50% 内容。
   单色/全彩共用变量体系。 */

.delegate-card {
  --delegate-primary: var(--color-primary);
  --delegate-muted: var(--color-primary-60, var(--color-primary));
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px 16px;
  box-sizing: border-box;
  background-color: var(--color-background);
  color: var(--delegate-primary);
}

.delegate-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.delegate-brand {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.delegate-logo {
  width: 20px;
  height: 20px;
}

.delegate-title {
  font-family: sans-serif;
  font-size: 16px;
  line-height: 20px;
  font-weight: 600;
  color: var(--delegate-primary);
}

.delegate-indicator {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.delegate-ind-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5px;
}

.delegate-ind-line {
  width: 20px;
  height: 2px;
  border-radius: 1px;
  margin-left: 5px;
  background-color: var(--delegate-primary);
  opacity: 0.3;
}

.delegate-ind-line-done {
  opacity: 0.9;
}

.delegate-ind-dot {
  width: 14px;
  height: 14px;
  border-radius: 7px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.delegate-ind-check {
  width: 10px;
  height: 10px;
}

.delegate-ind-dot-done {
  background-color: var(--delegate-primary);
  color: var(--color-background);
}

.delegate-ind-dot-active {
  border: 2px solid var(--delegate-primary);
  box-sizing: border-box;
}

.delegate-ind-dot-pending {
  background-color: var(--delegate-primary);
  opacity: 0.5;
}

.delegate-body {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.delegate-step-title {
  font-family: sans-serif;
  font-size: 17px;
  line-height: 22px;
  font-weight: 600;
  color: var(--delegate-primary);
  flex-shrink: 0;
}

.delegate-step-content {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 20px;
  color: var(--delegate-primary);
  opacity: 0.5;
}

.delegate-enter {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 9px 0;
  border: 1px solid var(--delegate-primary);
  border-radius: 6px;
}

.delegate-enter-active {
  opacity: 0.6;
}

.delegate-enter-text {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 18px;
  font-weight: 600;
  color: var(--delegate-primary);
}

@media (target: _blank) {
  .delegate-card {
    gap: 12px;
    padding: 18px 20px;
  }

  .delegate-title {
    font-size: 18px;
    line-height: 22px;
  }

  .delegate-step-title {
    font-size: 19px;
    line-height: 24px;
  }

  .delegate-step-content {
    font-size: 16px;
    line-height: 22px;
  }

  .delegate-enter {
    padding: 12px 0;
    border-radius: 8px;
  }
}
