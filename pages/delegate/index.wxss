/* 委托卡片：两行紧凑布局（标题+状态/进度点一行，请求摘要或结果一行），
   单色/全彩共用变量体系，_blank 全屏时仅放大留白。 */

.delegate-card {
  --delegate-primary: var(--color-primary);
  --delegate-muted: var(--color-primary-60, var(--color-primary));
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 12px;
  box-sizing: border-box;
  background-color: var(--color-background);
  color: var(--delegate-primary);
}

.delegate-main-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.delegate-title {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 18px;
  font-weight: 600;
  color: var(--delegate-primary);
}

.delegate-status {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 16px;
  color: var(--delegate-primary);
}

.delegate-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4px;
  margin-left: auto;
}

.delegate-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  background-color: var(--delegate-muted);
  opacity: 0.35;
}

.delegate-dot-active {
  opacity: 1;
}

.delegate-dot-done {
  opacity: 0.85;
}

.delegate-request {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 16px;
  color: var(--delegate-muted);
}

.delegate-request-done {
  color: var(--delegate-primary);
}

.delegate-request-error {
  color: var(--delegate-muted);
}

@media (target: _blank) {
  .delegate-card {
    gap: 8px;
    padding: 16px 20px;
  }
}
