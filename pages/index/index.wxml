  <view class="prism-viewport" bindtap="handleInteraction">
    <view class="prism-main-screen">
      <view class="prism-toast" ink:if="{{toastVisible}}" bindtap="handleToastTap">
        <text>{{toastText}}</text>
        <text>{{toastSeconds}}s</text>
      </view>

      <view class="prism-main-topbar" ink:if="{{surface !== 'inbox'}}">
        <view class="prism-topbar-title">
          <image class="prism-icon-20 prism-agent-icon" src="{{currentAgentIcon}}" />
          <text class="prism-thread-title">{{threadTitleDisplay}}</text>
        </view>
        <view class="prism-topbar-status">
          <view class="prism-context-ring" ink:if="{{contextVisible}}" aria-label="{{text.chat.ariaContextUsage}}">
            <text>{{contextLabel}}</text>
          </view>
          <text class="prism-top-status-item prism-permission">{{permissionLabel}}</text>
          <text class="prism-top-status-item prism-model">{{modelLabel}}</text>
        </view>
      </view>

      <view class="prism-plan" ink:if="{{planVisible}}">
        <text>{{text.chat.planPrefix}}{{planText}}</text>
      </view>

      <view class="{{chatClass}}">
        <view class="prism-chat-progress" aria-label="{{text.chat.ariaChatProgress}}">
          <view ink:for="{{chatProgressSegments}}" ink:key="id" class="{{item.className}}"></view>
        </view>
        <scroll-view class="prism-main-chatbox" scroll-y="true" scroll-into-view="{{chatScrollIntoView}}" data-scroll-revision="{{chatScrollRevision}}">
          <view class="prism-chat-top-spacer" style="{{chatTopSpacerStyle}}"></view>
          <view class="prism-empty" ink:if="{{!visibleChatItems.length}}">
            <canvas id="prismConversationLoader" class="prism-loading-spinner" width="36" height="36" ink:if="{{surface === 'main' ? (messagesLoading ? !messagesLoaded : false) : false}}"></canvas>
            <text>{{surface === 'main' ? (messagesLoading ? (!messagesLoaded ? text.common.loading : text.chat.noMessages) : text.chat.noMessages) : text.chat.noMessages}}</text>
          </view>
          <view class="prism-chat-content" ink:else>
            <view ink:for="{{visibleChatItems}}" ink:key="key" id="{{item.anchorId}}" class="{{item.className}}">
              <view class="prism-user-bubble" ink:if="{{item.kind === 'user'}}">
                <view class="prism-user-bubble-body">
                  <text class="prism-interaction-title" ink:if="{{item.interactionTitle}}">{{item.interactionTitle}}</text>
                  <text class="prism-user-copy">{{item.content}}</text>
                  <text class="prism-message-status" ink:if="{{item.statusLabel}}">{{item.statusLabel}}</text>
                </view>
              </view>
              <text class="prism-message-meta" ink:elif="{{item.kind === 'assistant_meta'}}">{{item.text}}</text>
              <streamdown
                class="prism-streamdown"
                ink:elif="{{item.kind === 'assistant_markdown'}}"
                content="{{item.content}}"
                font-size="15"
              ></streamdown>
            </view>
            <view class="prism-processing" ink:if="{{isRunning}}">
              <text class="prism-spinner">·</text>
              <text>{{runSummary || text.chat.agentReplying}}</text>
            </view>
            <view id="prism-chat-bottom-a" class="prism-chat-bottom-anchor"></view>
            <view id="prism-chat-bottom-b" class="prism-chat-bottom-anchor"></view>
          </view>
        </scroll-view>
      </view>

      <view class="prism-inbox-panel" ink:if="{{surface === 'inbox'}}" role="navigation">
        <view class="prism-inbox-carousel" ink:if="{{inboxFocusedItem}}">
          <text class="prism-inbox-day">{{inboxFocusedItem.groupLabel}}</text>
          <image class="prism-inbox-icon prism-agent-icon" src="{{inboxFocusedItem.icon}}" />
          <view class="{{inboxMotion ? 'prism-inbox-cards is-moving' : 'prism-inbox-cards'}}">
            <view class="prism-inbox-card" ink:for="{{inboxItems}}" ink:key="id" style="{{item.cardStyle}}">
              <button data-id="{{item.id}}" tabindex="{{item.tabIndex}}" class="{{item.className}}" bindtap="handleInboxTap">
                <text class="prism-inbox-label">{{item.label}}</text>
              </button>
              <view class="{{item.statusDotClass}}"></view>
            </view>
          </view>
          <view class="prism-inbox-meta">
            <text class="prism-inbox-project">{{inboxFocusedItem.projectName}}</text>
            <text ink:if="{{inboxFocusedItem.timeLabel}}" class="prism-inbox-meta-dot">·</text>
            <text ink:if="{{inboxFocusedItem.timeLabel}}" class="prism-inbox-time">{{inboxFocusedItem.timeLabel}}</text>
          </view>
          <view class="prism-inbox-progress" aria-label="{{text.chat.ariaInboxProgress}}">
            <view ink:for="{{inboxProgressDots}}" ink:key="id" class="{{item.className}}"></view>
          </view>
        </view>
      </view>

      <view class="prism-control-panel" ink:if="{{surface === 'controls'}}" role="navigation">
        <text class="prism-control-title">{{controlTitle}}</text>
        <scroll-view class="prism-control-list" scroll-y="true">
          <button ink:for="{{controlItems}}" ink:key="id" tabindex="0" data-index="{{item.idx}}" class="{{item.className}}" bindtap="handleControlTap">{{item.label}}</button>
        </scroll-view>
      </view>

      <view class="prism-approval-panel" ink:if="{{surface === 'approval'}}" role="navigation">
        <text>{{approvalText}}</text>
        <view class="prism-approval-actions">
          <button ink:for="{{approvalActions}}" ink:key="id" tabindex="0" data-index="{{item.idx}}" class="{{item.className}}" bindtap="handleApprovalTap">{{item.label}}</button>
        </view>
      </view>

      <view class="prism-approval-panel prism-question-panel" ink:if="{{surface === 'question'}}" role="navigation">
        <text>{{questionText}}</text>
        <text class="prism-muted" ink:if="{{questionReply}}">{{questionReply}}</text>
        <scroll-view class="prism-question-list" scroll-y="true" scroll-into-view="{{'question-action-' + focusIndex}}">
          <view class="prism-question-actions">
            <button ink:for="{{questionActions}}" ink:key="id" id="question-action-{{item.idx}}" tabindex="0" data-index="{{item.idx}}" class="{{item.className}}" bindtap="handleQuestionTap">{{item.label}}</button>
          </view>
        </scroll-view>
      </view>

      <view class="prism-bottom-stack">
        <view class="prism-draft" ink:if="{{draftText || listening || recognizing}}">
          <text ink:if="{{draftText}}">{{draftText}}</text>
          <text class="prism-muted" ink:else>{{voiceHint}}</text>
        </view>

        <view class="{{surface === 'inbox' ? 'prism-menu prism-menu-hidden' : menuClass}}" role="navigation">
          <block ink:if="{{surface === 'voice'}}">
            <!-- Keep the existing stop-menu gesture and focus behavior. -->
            <view ink:for="{{menuButtons}}" ink:key="id" data-index="{{item.idx}}" class="{{item.className}}" bindtap="handleMenuTap">
              <lottie-view ink:if="{{recognizing}}" src="../../assets/voice-processing.json" class="prism-icon-14" auto-play="true" loop="true"></lottie-view>
              <image ink:else class="prism-icon-14 prism-lucide-icon" src="{{item.icon}}" />
              <text ink:if="{{item.showLabel}}">{{recognizing ? voiceHint : item.label}}</text>
            </view>
          </block>
          <block ink:else>
            <button ink:for="{{menuButtons}}" ink:key="id" tabindex="0" data-index="{{item.idx}}" class="{{item.className}}" bindtap="handleMenuTap">
              <image class="prism-icon-14 prism-lucide-icon" src="{{item.icon}}" />
              <text ink:if="{{item.showLabel}}">{{item.label}}</text>
            </button>
          </block>
        </view>

        <view class="prism-bottom-tips" ink:if="{{surface !== 'inbox'}}">
          <text ink:if="{{unreadCount > 0}}">{{unreadCount}}{{text.chat.unreadPrefix}}</text>
          <text>{{surface === 'main' ? text.chat.hintMain : text.chat.hintMenu}}</text>
        </view>
      </view>

      <view class="prism-desktop-guide" ink:if="{{connectionGuideVisible}}" role="status">
        <text class="prism-desktop-guide-title">{{text.boot.guideTitle}}</text>
        <text class="prism-desktop-guide-hint">{{text.boot.guideHint}}</text>
      </view>

      <view class="prism-loading-overlay" ink:if="{{surface === 'inbox' ? (!menuVisible ? (loading || inboxLoading) : false) : false}}" role="status">
        <view class="prism-loading-state">
          <canvas id="prismLoadingLogo" class="prism-loading-logo" width="148" height="148"></canvas>
          <text class="prism-loading-label" ink:if="{{loading}}">{{text.boot.connectingAgent}}</text>
          <text class="prism-loading-label" ink:else>{{text.common.loading}}</text>
        </view>
      </view>
    </view>
  </view>
