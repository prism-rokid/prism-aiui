.prism-viewport {
  --prism-primary: var(--color-primary);
  --prism-primary-60: rgba(64, 255, 94, 0.6);
  --prism-primary-30: rgba(64, 255, 94, 0.3);
  --prism-primary-20: rgba(64, 255, 94, 0.2);
  --prism-primary-10: rgba(64, 255, 94, 0.1);
  /* The Glasses host uses a 480×352 logical full-screen canvas. Pinning the
     root avoids a transient 100vh re-measurement when the inbox remounts. */
  width: 480px;
  height: 352px;
  min-width: 480px;
  min-height: 352px;
  max-width: 480px;
  max-height: 352px;
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--color-background);
}

.prism-main-screen {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  flex-direction: column;
  box-sizing: border-box;
  background-color: var(--color-background);
}

text, button {
  color: var(--prism-primary);
  font-family: monospace;
  font-size: 14px;
  line-height: 17px;
}

button {
  width: auto;
  min-width: 26px;
  min-height: 26px;
  display: flex;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  box-sizing: border-box;
  border: 0.5px solid var(--prism-primary-20);
}

.prism-main-topbar {
  width: 100%;
  display: flex;
  flex-shrink: 0;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  padding: var(--spacing-sm);
  z-index: 4;
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}

.prism-topbar-title, .prism-topbar-status,
.prism-agent-icons, .prism-approval-actions, .prism-menu,
.prism-menu block, block,
.prism-processing {
  display: flex;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
}

.prism-topbar-title {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  gap: var(--spacing-sm);
}
.prism-topbar-status {
  flex-grow: 0;
  flex-shrink: 0;
  flex-basis: auto;
  justify-content: flex-end;
  gap: 8px;
}
.prism-permission { opacity: 0.5; }
.prism-model { opacity: 1; }
.prism-thread-title {
  width: auto;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  overflow: hidden;
}
.prism-icon-20 { width: 20px; height: 20px; flex-shrink: 0; }
.prism-icon-14 { width: 14px; height: 14px; flex-shrink: 0; }
.prism-lucide-icon {
  opacity: 1;
  color: var(--prism-primary);
  fill: var(--prism-primary);
}
.prism-agent-icon {
  opacity: 1;
}

.prism-top-status-item {
  width: auto;
  flex-grow: 0;
  flex-shrink: 0;
  flex-basis: auto;
}
.prism-context-ring {
  width: 28px;
  height: 28px;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 0.5px solid var(--prism-primary-60);
  border-radius: 50%;
}
.prism-context-ring text { font-size: 12px; line-height: 14px; }

.prism-plan {
  width: 100%;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  box-sizing: border-box;
  padding: var(--spacing-sm);
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}

.prism-main-chat {
  width: 100%;
  height: 100%;
  min-height: 1px;
  display: flex;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: auto;
  flex-direction: row;
  align-items: stretch;
  box-sizing: border-box;
  padding: var(--spacing-sm) 0;
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}

.prism-main-chat-thread-picker { display: none; }
.prism-main-chatbox {
  width: 100%;
  height: 100%;
  min-height: 1px;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: auto;
  box-sizing: border-box;
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}
.prism-chat-progress {
  width: 2px;
  height: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 6px 0 6px 3px;
  display: flex;
  flex-direction: column;
}
.prism-chat-progress-segment, .prism-list-progress-segment {
  width: 2px;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  background-color: transparent;
}
.prism-chat-progress-segment.is-loaded {
  background-color: var(--prism-primary);
  opacity: 0.2;
}
.prism-chat-progress-segment.is-current, .prism-list-progress-segment.is-current {
  background-color: var(--prism-primary);
  opacity: 0.4;
}
.prism-chat-top-spacer { width: 100%; flex-shrink: 0; }
/* Two stacked bottom targets alternate as the scroll-into-view value so every
   bottom follow-up re-triggers the scroll even while the id stays "at bottom". */
.prism-chat-bottom-anchor { width: 100%; height: 1px; flex-shrink: 0; }
.prism-chat-content { width: 100%; display: flex; flex-direction: column; align-items: flex-end; box-sizing: border-box; padding: var(--spacing-sm) var(--spacing-md); }
.prism-empty { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--spacing-md); opacity: 0.6; }
.prism-loading-overlay {
  position: absolute;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-background);
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}
.prism-loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-lg);
}
.prism-loading-logo { width: 148px; height: 148px; }
.prism-loading-spinner {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
}
.prism-loading-label { font-family: sans-serif; font-size: 14px; line-height: 18px; }
.prism-desktop-guide {
  position: absolute;
  inset: 0;
  z-index: 15;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
  background-color: var(--color-background);
}
.prism-desktop-guide-title {
  font-family: sans-serif;
  font-size: 16px;
  font-weight: 600;
  line-height: 20px;
  color: var(--color-text-primary);
  text-align: center;
}
.prism-desktop-guide-hint {
  font-family: sans-serif;
  font-size: 16px;
  line-height: 20px;
  color: var(--color-text-secondary);
  text-align: center;
}
.prism-message { width: 100%; display: flex; flex-shrink: 0; flex-direction: column; }
.prism-message-user { align-items: flex-end; margin-bottom: var(--spacing-md); }
.prism-chat-row { width: 100%; display: flex; flex-shrink: 0; flex-direction: column; align-items: flex-start; box-sizing: border-box; }
.prism-agent-meta-row { margin-bottom: var(--spacing-sm); }
.prism-agent-row-end { margin-bottom: var(--spacing-md); }

.prism-user-bubble {
  width: auto;
  max-width: 85%;
  align-self: flex-end;
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  border: 0.5px solid var(--prism-primary-30);
  border-radius: 4px;
}

.prism-user-bubble-body {
  width: auto;
  min-width: 1px;
  max-width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  /* Includes the former side inset; the border no longer reserves image space. */
  padding: 2px 8px 4.5px;
}

.prism-user-copy, .prism-message-meta, .prism-message-status, .prism-agent-copy, .prism-processing text {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 18px;
}
.prism-user-copy {
  width: auto;
  max-width: 100%;
  overflow: hidden;
  word-break: break-all;
  white-space: pre-wrap;
}
.prism-message-meta { width: 100%; opacity: 0.5; }
.prism-message-status { align-self: flex-end; opacity: 0.5; }
.prism-agent-copy { width: 100%; }

.prism-agent-markdown-row { width: 100%; max-width: 100%; margin-bottom: var(--spacing-md); overflow: visible; }
/* Inline code borders extend above glyph bounds; keep a small paint inset
   and let the chat viewport own clipping instead of clipping each reply. */
.prism-streamdown { width: 100%; max-width: 100%; flex-shrink: 0; box-sizing: border-box; padding: 3px 0; overflow: visible; font-family: sans-serif; font-size: 15px; line-height: 24px; }
.prism-processing { width: 100%; align-self: flex-start; gap: var(--spacing-sm); opacity: 0.7; }
.prism-spinner { width: 12px; text-align: center; }
.prism-muted { opacity: 0.5; }

.prism-bottom-stack {
  width: 100%;
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  box-sizing: border-box;
  background-color: var(--color-background);
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}

.prism-bottom-tips {
  width: 100%;
  display: flex;
  flex-shrink: 0;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
  padding: 2px var(--spacing-sm);
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
  opacity: 0.5;
  z-index: 5;
}

.prism-menu {
  width: auto;
  display: flex;
  flex-shrink: 0;
  flex-direction: row;
  flex-wrap: nowrap;
  align-self: flex-end;
  align-items: center;
  justify-content: flex-end;
  gap: var(--spacing-sm);
  box-sizing: border-box;
  margin-top: var(--spacing-sm);
  padding: 2px var(--spacing-sm);
  z-index: 12;
  background-color: var(--color-background);
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}

.prism-menu-hidden {
  display: none;
}

.prism-menu block,
.prism-menu > block,
block {
  width: auto;
  display: flex;
  flex-shrink: 0;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: flex-end;
  gap: var(--spacing-sm);
}

.prism-menu-button {
  width: auto;
  min-width: 26px;
  height: 26px;
  min-height: 26px;
  display: flex;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm);
  /* The recording stop affordance renders as a plain view, so the guide
     border cannot rely on the button element rule alone. */
  border: 0.5px solid var(--prism-primary-20);
  border-radius: var(--radius-md);
}
.prism-menu-button.is-disabled { opacity: 0.3; }
.prism-menu-button.is-focused { background-color: var(--prism-primary-10); border-color: var(--prism-primary-60); }
.prism-menu-button.is-selected { background-color: var(--prism-primary-10); }

.prism-draft {
  width: 100%;
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  box-sizing: border-box;
  /* Same top-aligned text compensation as .prism-user-bubble-body. */
  padding: 1px calc(var(--spacing-md) / 2) 6px;
  z-index: 11;
  background-color: var(--prism-primary-10);
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}

.prism-list-layout { width: 100%; height: 0; min-height: 0; display: flex; flex-grow: 1; flex-shrink: 1; flex-basis: 0; flex-direction: row; box-sizing: border-box; }
.prism-list-progress { width: 2px; height: 100%; flex-shrink: 0; box-sizing: border-box; margin: 6px 0 6px 3px; display: flex; flex-direction: column; }
.prism-status-dot { width: 5px; height: 5px; flex-shrink: 0; border-radius: var(--radius-md); background-color: var(--prism-primary); opacity: 0; transition-property: opacity; transition-duration: 240ms; transition-timing-function: ease-in-out; }
.prism-status-dot.is-unread { opacity: 1; }
.prism-status-dot.is-running { opacity: 0.35; }
.prism-status-dot.is-pulse-mid { opacity: 0.65; }
.prism-status-dot.is-pulse-high { opacity: 1; }

.prism-inbox-panel {
  width: 100%;
  height: 0;
  min-height: 0;
  display: flex;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  z-index: 11;
  background-color: var(--color-background);
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}
.prism-inbox-list { width: 100%; height: 100%; min-height: 1px; flex-grow: 1; flex-shrink: 1; flex-basis: auto; }
.prism-inbox-list-content { width: 100%; display: flex; flex-direction: column; }
/* Ink renders block as a real view; use an explicit vertical row wrapper so
   group headers add height above their conversation instead of sitting beside it. */
.prism-inbox-row { width: 100%; display: flex; flex-direction: column; flex-shrink: 0; }
/* The header height must stay in lockstep with INBOX_GROUP_HEADER_HEIGHT:
   the focus scroll math treats it as a fixed row. */
.prism-inbox-group { width: 100%; height: 24px; display: flex; flex-shrink: 0; flex-direction: row; align-items: flex-end; box-sizing: border-box; padding: 0 var(--spacing-md) 3px; }
.prism-inbox-group-label { font-family: sans-serif; font-size: 12px; line-height: 14px; text-align: left; opacity: 0.85; }
/* Lets the scroll view reach the top-aligned offset of the last rows; it must
   stay at least as tall as the list viewport. */
.prism-inbox-list-tail { width: 100%; height: 320px; flex-shrink: 0; }
/* Rows are a fixed 44px (INBOX_ITEM_HEIGHT); the label must never wrap. */
.prism-inbox-choice { width: 100%; height: 44px; min-height: 44px; overflow: hidden; display: flex; flex-shrink: 0; flex-direction: row; align-items: center; gap: var(--spacing-sm); box-sizing: border-box; padding: var(--spacing-sm) var(--spacing-md); border: 0.5px solid transparent; }
.prism-inbox-choice.is-focused { background-color: var(--prism-primary-10); border-color: var(--prism-primary-60); }
.prism-inbox-icon { flex-shrink: 0; }
.prism-inbox-body { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; display: flex; flex-direction: column; overflow: hidden; }
.prism-inbox-label { font-family: sans-serif; font-size: 14px; line-height: 18px; height: 18px; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.prism-inbox-meta { display: flex; flex-direction: row; align-items: center; gap: 4px; min-width: 0; }
.prism-inbox-project { font-family: sans-serif; font-size: 11px; line-height: 14px; text-align: left; opacity: 0.6; white-space: nowrap; overflow: hidden; }
.prism-inbox-meta-dot { flex-shrink: 0; font-family: sans-serif; font-size: 11px; line-height: 14px; opacity: 0.45; }
.prism-inbox-time { flex-shrink: 0; font-size: 11px; line-height: 14px; text-align: left; opacity: 0.6; }

.prism-control-panel {
  width: 100%;
  display: flex;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  flex-direction: column;
  gap: var(--spacing-sm);
  box-sizing: border-box;
  padding: var(--spacing-sm);
  z-index: 14;
  background-color: var(--color-background);
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}
.prism-control-title { opacity: 0.5; }
.prism-control-list { width: 100%; height: 100%; flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.prism-control-choice { width: 100%; min-width: 26px; display: flex; flex-shrink: 0; flex-direction: row; align-items: center; box-sizing: border-box; padding: var(--spacing-sm) var(--spacing-md); border: 0.5px solid transparent; text-align: left; }
.prism-control-choice.is-focused { background-color: var(--prism-primary-10); border-color: var(--prism-primary-60); }
.prism-control-choice.is-selected { background-color: var(--prism-primary-10); }

.prism-approval-panel {
  width: 100%;
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  gap: var(--spacing-md);
  box-sizing: border-box;
  padding: var(--spacing-md);
  z-index: 15;
  background-color: var(--color-background);
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
}
.prism-approval-actions { justify-content: flex-end; gap: 8px; }

.prism-toast {
  width: 100%;
  display: flex;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: var(--spacing-sm) var(--spacing-md);
  z-index: 20;
  background-color: var(--prism-primary-10);
  border-top: 0.5px solid var(--prism-primary-20);
  border-bottom: 0.5px solid var(--prism-primary-20);
  border-radius: var(--radius-md);
}

.prism-layer-hidden {
  display: none;
}
